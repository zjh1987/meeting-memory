APP_PASSWORD=change-me
COOKIE_SECRET=
DATA_DIR=./data
SITE_DIR=./site
ASR_BACKEND=mock
FUNASR_MODEL_DIR=./models/funasr
FUNASR_DEVICE=cpu
HOTWORD_FILE=./config/hotwords.txt
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_UPLOAD_MB=1024
MIN_FREE_GB=5
# 处理参数按 8GB GPU 实测校准：模型首次加载约 10s，40s 音频转写约 2s，
# 8k 字纪要约 2s；CPU 部署时转写会明显变慢，但心跳仍每 60s 续期。
SCAN_INTERVAL=3
HEARTBEAT_INTERVAL=60
ZOMBIE_TIMEOUT=180
AUTO_RETRY_MAX=1
RETRY_BACKOFF_SEC=30
# cam++ 聚类阈值：偏低倾向合并说话人，偏高倾向拆分。双人合成样本上
# 0.70/0.78/0.86 结果一致，真实录音可按分离效果微调。
SPEAKER_THRESHOLD=0.75
# 最长录音时长（分钟），默认 6 小时；0 表示不限制，可在管理后台修改
MAX_DURATION_MIN=360
LOG_DIR=./logs
